OKB_TOKEN_ADDRESS=

# ==============================================================================
# Game Configuration
# ==============================================================================
# First game only for update anchor root
TEMP_MAX_CLOCK_DURATION=20
TEMP_CLOCK_EXTENSION=5
TEMP_GAME_WINDOW=60

# Game config
MAX_CLOCK_DURATION=20
CLOCK_EXTENSION=10
GAME_WINDOW=60

# AnchorStateRegistry configure
DISPUTE_GAME_FINALITY_DELAY_SECONDS=5

# PreimageOracle configure
CHALLENGE_PERIOD_SECONDS=10

# WETH configure
WITHDRAWAL_DELAY_SECONDS=$MAX_CLOCK_DURATION

# ==============================================================================
# Fork Configuration
# ==============================================================================
# TODO: use real fork block and parent hash in xlayer erigon
FORK_BLOCK=8593920
PARENT_HASH="0x6912fea590fd46ca6a63ec02c6733f6ffb942b84cdf86f7894c21e1757a1f68a"
NEW_BLOCK_HASH=0xddb9bdc86631494bab4b4749c4575035e2383da7c96d32d31341de862b1dd6c9

MERGE_RETH_GENESIS=false
MERGE_RETH_CHAIN=xlayer-testnet
MERGE_RETH_DATADIR_PATH=
XLAYER_RETH_TOOLS_IMAGE_TAG=xlayer-reth-tools:latest
USE_CHAINSPEC=false

# ==============================================================================
# Other Configuration
# ==============================================================================
DB_ENGINE="pebble"

CONDUCTOR_ENABLED=false
# Number of sequencer nodes in the conductor cluster (ignored when
# CONDUCTOR_ENABLED=false, which always runs a single sequencer).
SEQ_COUNT=3
LAUNCH_RPC_NODE=true
# Number of RPC nodes (independent of SEQ_COUNT; ignored when LAUNCH_RPC_NODE=false)
RPC_COUNT=1

# ==============================================================================
# Optional RCS Risk-Control Sidecars
# ==============================================================================
# false preserves the legacy topology: no TZMock/RCS containers and every
# sequencer's RCS Filter remains disabled.
RCS_ENABLED=false
# Number of RCS instances. When enabled this must not exceed the effective
# sequencer count; RCS i is paired with sequencer i.
RCS_COUNT=1
# Source tree used for local image builds. Relative paths resolve from devnet/.
RCS_LOCAL_DIRECTORY=../../xlayer-rcs
RCS_IMAGE_TAG=xlayer-rcs:latest
TZMOCK_IMAGE_TAG=tzmock:latest
SKIP_RCS_BUILD=false
SKIP_TZMOCK_BUILD=false
# Non-empty TOML array copied directly into each generated RCS config.
RCS_KNOWN_BRIDGE_ADDRESSES='["0x14dC79964da2C08b23698B3D3cc7Ca32193d9955"]'
RCS_HOST_PORT_BASE=9195
TZMOCK_HOST_PORT=9500

# Trusted peers enode url configurations for the shared private sequencer txpool
TRUSTED_PEERS=

# Whether reth nodes restrict peering to trusted peers only (trusted_nodes_only).
# true  -> reth >=2.2 connects to / accepts ONLY the enodes in TRUSTED_PEERS.
# false -> untrusted peers are also allowed.
# 3-op-init.sh writes this value into the reth seq/rpc config TOMLs. Note that
# discovery is disabled in the reth entrypoints, so TRUSTED_PEERS is always
# applied for connectivity regardless of this toggle. The cluster generator
# includes all sequencer enodes, plus all generated RPC enodes when true.
TRUSTED_NODES_ONLY=false

FLASHBLOCK_ENABLED=true
FLASHBLOCK_P2P_ENABLED=true
FLASHBLOCKS_DEBUG_STATE_COMPARISON=false

OWNER_TYPE=transactor # safe
