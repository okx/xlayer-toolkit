# ==============================================================================
# OP Stack Configuration
# ==============================================================================
OP_STACK_LOCAL_DIRECTORY=
SKIP_OP_STACK_BUILD=true
OP_STACK_IMAGE_TAG=op-stack:latest

# ==============================================================================
# Kona Configuration (alternative CL, built from optimism/rust workspace under
# ==============================================================================
SKIP_KONA_BUILD=true
KONA_IMAGE_TAG=kona:latest

# ==============================================================================
# OP Contracts Configuration
# ==============================================================================
SKIP_OP_CONTRACTS_BUILD=true
OP_CONTRACTS_IMAGE_TAG=op-contracts:latest

# ==============================================================================
# OP Geth Configuration
# ==============================================================================
OP_GETH_LOCAL_DIRECTORY=
OP_GETH_BRANCH=
SKIP_OP_GETH_BUILD=true
OP_GETH_IMAGE_TAG=op-geth:latest

# ==============================================================================
# OP Reth Configuration
# ==============================================================================
OP_RETH_LOCAL_DIRECTORY=
OP_RETH_BRANCH=
SKIP_OP_RETH_BUILD=true
OP_RETH_IMAGE_TAG=op-reth:latest

# Profiling configuration for op-reth
RETH_PROFILING_ENABLED=false
JEMALLOC_PROFILING=false

# RocksDB storage configuration for op-reth nodes. This is a
# genesis-initialization-only choice: run clean.sh and re-sync before changing
# either value for an existing devnet datadir.
# true selects the selected image's default-v2 behavior. The scripts do not pass
# --storage.v2=true, so this keeps v2 only for supported images where it is the
# default; it does not force v2 on an image with a different default. That v2
# layout routes history indices (AccountsHistory, StoragesHistory,
# TransactionHashNumbers) to RocksDB instead of MDBX, and moves receipts/tx-senders/
# account+storage changesets to static files. false requests --storage.v2=false
# only when the selected image advertises that option.
# WARNING: This is a genesis-initialization-only setting. Changing it on an existing
# datadir requires a full re-sync.
RETH_STORAGE_V2=false
# Optional: when the selected image uses v2, override the default RocksDB data
# path (defaults to <datadir>/rocksdb). Leave empty to use the default path.
RETH_ROCKSDB_PATH=

# ==============================================================================
# XLayer Gasless Configuration
# ==============================================================================
# ENABLE_GASLESS turns on the reth/geth mempool feature.
ENABLE_GASLESS=true
# Percentile used to compute the mock gas price for gasless (0-price) txs. 0.1 (Default) takes the price at 0.1*N from the sorted list.
GASLESS_MOCK_GAS_PRICE_PERCENTILE=0.1
# Max seconds a gasless (0-price) tx may sit in the pending sub-pool before the gasless maintenance
# task evicts it as stale. Passed as --rollup.gasless-pending-lifetime to the reth seq/rpc nodes. Default 600.
GASLESS_PENDING_LIFETIME_SECS=600
# Per-block gas budget for gasless txs (gas units). The Reth entrypoints pass
# --builder.gasless-block-gas-limit when supported; only Sequencers build blocks.
# 0 = unlimited. Default 60000000.
BUILDER_GASLESS_BLOCK_GAS_LIMIT=60000000
# Whether to both deploy the GaslessWhitelist contract and set its gaslessEnabled flag. Independent of ENABLE_GASLESS.
CONTRACT_ALLOW_GASLESS=true
# Owner of the GaslessWhitelist contract and its auto-deployed ProxyAdmin (the account allowed to
# call setGaslessEnabled and to upgrade the implementation). Well-known public devnet test account
# (Anvil #9), funded on L2 genesis. Its key is RICH_L1_PRIVATE_KEY below.
GASLESS_WHITELIST_OWNER=0x14dC79964da2C08b23698B3D3cc7Ca32193d9955

# ==============================================================================
# ZK Proof Engine Configuration
# ==============================================================================
# PROOF_ENGINE: none | op-succinct | kailua
PROOF_ENGINE=none
PROOF_MOCK_MODE=true
PROOF_FAST_FINALITY_MODE=false

# --- OP Succinct ---
OP_SUCCINCT_LOCAL_DIRECTORY=
SKIP_OP_SUCCINCT_BUILD=true
OP_SUCCINCT_IMAGE_TAG=op-succinct:latest
OP_SUCCINCT_CONTRACTS_IMAGE_TAG=op-succinct-contracts:latest

# --- Kailua ---
KAILUA_LOCAL_DIRECTORY=
SKIP_KAILUA_BUILD=true
KAILUA_IMAGE_TAG=kailua:latest

# ==============================================================================
# Build Configuration
# ==============================================================================
SKIP_BUILD_PRESTATE=false

# ==============================================================================
# Runtime Mode Configuration
# ==============================================================================
# MIN_RUN: Skip proposer/challenger/dispute monitor setup for minimal deployment
# When enabled (default), only essential services (sequencer, op-node, op-batcher, rpc) will run
# Set to false if you need full mode with op-proposer, op-challenger, op-dispute-mon
MIN_RUN=true

# ==============================================================================
# Docker & Network Configuration
# ==============================================================================
DOCKER_NETWORK=dev-op
# Load both the static compose file and the generator's cluster overlay.
COMPOSE_FILE=docker-compose.yml:docker-compose.cluster.yml
CONFIG_DIR=config-op

# Only support `geth` or `reth`
SEQ_TYPE=reth
RPC_TYPE=reth

# Consensus-layer client. One of: `opnode`, `kona`.
# `opnode` uses op-seq / op-rpc (Go op-node). `kona` uses op-kona-seq / op-kona-rpc
# (Rust kona-node).
# `SEQ_CL=kona` supports only the single-sequencer, non-conductor topology.
# `RPC_CL` may be selected independently for every configured RPC node.
# After changing SEQ_COUNT, RPC_COUNT, SEQ_CL, or RPC_CL, run clean.sh before
# regenerating the devnet so identities and docker-compose.cluster.yml match.
SEQ_CL=opnode
RPC_CL=opnode

# ==============================================================================
# Chain Configuration
# ==============================================================================
CHAIN_ID=195

# ==============================================================================
# RPC URLs
# ==============================================================================
# Host URLs
L1_RPC_URL=http://localhost:8545
# Host -> L2 sequencer JSON-RPC (write / immediate-state flows target this).
L2_SEQ_URL=http://localhost:8123
# Host -> L2 normal RPC node JSON-RPC (general queries).
L2_RPC_URL=http://localhost:8223

# Docker internal URLs
L1_RPC_URL_IN_DOCKER=http://l1-geth:8545
L2_RPC_URL_IN_DOCKER=http://op-$SEQ_TYPE-seq:8545
L1_BEACON_URL_IN_DOCKER=http://l1-beacon-chain:3500
L2_NODE_RPC_URL_IN_DOCKER=http://op-seq:9545

# ==============================================================================
